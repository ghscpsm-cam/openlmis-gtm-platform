# Producción MSPAS (openlmis.mspas.gob.gt, 16GB RAM): copiar a env/test.env sin ediciones.
# Corre como ambiente "test", igual que gtm. Recursos iguales a gtm (16GB, 4 CPUs).
# (OPENLMIS_URL es el health-check local; la URL pública va en settings.env del ref-distro.)
ENVIRONMENT=test

# Deployment ref-distro existente (ajustar dir si es una instancia separada)
REFDISTRO_DIR=/opt/openlmis-ref-distro
DB_CONTAINER=openlmis-ref-distro-db-1
DB_NAME=open_lmis
DB_USER=postgres
OPENLMIS_URL=http://localhost

# Imágenes GTM probadas como una unidad. No usar latest.
REFERENCE_UI_IMAGE=ghcr.io/ghscpsm-cam/openlmis-gtm-ui:8.0.1-gtm.5
STOCKMANAGEMENT_IMAGE=ghcr.io/ghscpsm-cam/openlmis-gtm-stockmanagement:5.3.0-gtm.4

# DNS interno MSPAS: el servidor no resuelve su propio dominio. Docker lo agrega al /etc/hosts
# de cada servicio para que validen tokens contra BASE_URL (dominio) sin pasar por el DNS.
OPENLMIS_HOST_ALIAS=openlmis.mspas.gob.gt
OPENLMIS_HOST_IP=192.168.50.124

# Nginx: tamaño máximo para PUT/POST grandes, por ejemplo requisiciones extensas.
CLIENT_MAX_BODY_SIZE=50m

# Recursos para servidor de 16GB (mismos valores que producción gtm). Requiere >= 4 CPUs.
REFERENCEDATA_MEM_LIMIT=5G
REFERENCEDATA_XMX=4096m
REFERENCEDATA_CPUS=4
REPORT_MEM_LIMIT=2G
REPORT_XMX=1536m
REPORT_CPUS=2
STOCKMANAGEMENT_MEM_LIMIT=2G
STOCKMANAGEMENT_XMX=1536m
STOCKMANAGEMENT_CPUS=2

# Capa 2 — seeder
SEEDER_DIR=/opt/openlmis-seeder
SEED_SET=minimal
SEED_USERNAME=admin
SEED_PASSWORD=password

# Baseline esqueleto para `platform reset`
BASELINE_FILE=baselines/test_baseline.dump
