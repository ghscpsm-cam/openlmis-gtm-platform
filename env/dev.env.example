# Ambiente DEV — platform orquesta el ref-distro YA existente (no trae compose propio).
ENVIRONMENT=dev

# Deployment ref-distro existente
REFDISTRO_DIR=/opt/openlmis-ref-distro
DB_CONTAINER=openlmis-ref-distro-db-1
DB_NAME=open_lmis
DB_USER=postgres
OPENLMIS_URL=http://localhost

# Imágenes GTM probadas como una unidad. No usar latest.
REFERENCE_UI_IMAGE=ghcr.io/ghscpsm-cam/openlmis-gtm-ui:8.0.1-gtm.5
STOCKMANAGEMENT_IMAGE=ghcr.io/ghscpsm-cam/openlmis-gtm-stockmanagement:5.3.0-gtm.4

# Recursos opcionales para servicios pesados. Defaults conservadores para servidores de 8GB.
REFERENCEDATA_MEM_LIMIT=2G
REFERENCEDATA_XMX=1536m
REFERENCEDATA_CPUS=2
STOCKMANAGEMENT_MEM_LIMIT=2G
STOCKMANAGEMENT_XMX=1536m
STOCKMANAGEMENT_CPUS=2

# Capa 2 — seeder de datos maestros
SEEDER_DIR=/opt/openlmis-seeder
SEED_SET=minimal
# Usuario con rights de gestión para el seed (admin por defecto de OpenLMIS).
# Cambiar por el usuario de seed definitivo cuando se defina la gobernanza.
SEED_USERNAME=admin
SEED_PASSWORD=password

# Baseline esqueleto para `platform reset` (OpenLMIS migrado, sin datos de negocio).
BASELINE_FILE=baselines/dev_baseline.dump
