# Ambiente TEST — completar con los valores del deployment de test.
ENVIRONMENT=test

# Deployment ref-distro existente (ajustar dir/URL si test es una instancia separada)
REFDISTRO_DIR=/opt/openlmis-ref-distro
DB_CONTAINER=openlmis-ref-distro-db-1
DB_NAME=open_lmis
DB_USER=postgres
OPENLMIS_URL=http://localhost

# Capa 2 — seeder
SEEDER_DIR=/opt/openlmis-seeder
SEED_SET=minimal
SEED_USERNAME=admin
SEED_PASSWORD=password

# Baseline esqueleto para `platform reset`
BASELINE_FILE=baselines/test_baseline.dump
