# Ambiente TEST — completar con los valores del deployment de test.
ENVIRONMENT=test

# Deployment ref-distro existente (ajustar dir/URL si test es una instancia separada)
REFDISTRO_DIR=/opt/openlmis-ref-distro
DB_CONTAINER=openlmis-ref-distro-db-1
DB_NAME=open_lmis
DB_USER=postgres
OPENLMIS_URL=http://localhost

# Imágenes GTM probadas como una unidad. No usar latest.
REFERENCE_UI_IMAGE=ghcr.io/ghscpsm-cam/openlmis-gtm-ui:8.0.1-gtm.4
STOCKMANAGEMENT_IMAGE=ghcr.io/ghscpsm-cam/openlmis-gtm-stockmanagement:5.3.0-gtm.3

# Recursos opcionales para servicios pesados. Defaults conservadores para servidores de 8GB.
REFERENCEDATA_MEM_LIMIT=2G
REFERENCEDATA_XMX=1536m
REFERENCEDATA_CPUS=2
STOCKMANAGEMENT_MEM_LIMIT=2G
STOCKMANAGEMENT_XMX=1536m
STOCKMANAGEMENT_CPUS=2

# Capa 2 — seeder
SEEDER_DIR=/opt/openlmis-seeder
SEED_SET=minimal
SEED_USERNAME=admin
SEED_PASSWORD=password

# Baseline esqueleto para `platform reset`
BASELINE_FILE=baselines/test_baseline.dump
